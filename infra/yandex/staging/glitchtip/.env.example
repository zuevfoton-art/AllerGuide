# Copy to .env next to docker-compose.yml. Never commit .env.
# Generate SECRET_KEY:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me-glitchtip-db-only
SECRET_KEY=change-me-openssl-rand-hex-32
GLITCHTIP_DOMAIN=https://errors.staging.aclearo.com
GLITCHTIP_MAX_EVENT_LIFE_DAYS=90
# true until the first admin exists, then false and recreate the container
ENABLE_USER_REGISTRATION=true
DEFAULT_FROM_EMAIL=support@aclearo.com
EMAIL_URL=consolemail://
