# AllerGuide / Aclearo — environment variables
# Copy to `.env` and fill in values for local development.

# --- Mobile (Expo) ---
# Public API URL for optional cloud sync (disabled in v1.0 mobile UI)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Use PostgreSQL backend for auth and profiles (JWT)
EXPO_PUBLIC_BACKEND_AUTH=false

# Optional crash reporting (Sentry). Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=

# Smart LLM scan via API (/api/scan). Requires AI_SCAN_ENABLED on server.
EXPO_PUBLIC_AI_SCAN_ENABLED=false

# Cloud Vision OCR via /api/ocr (Yandex Vision). Demo OCR when false / offline.
EXPO_PUBLIC_YC_OCR=false

# Option B: GPT classifies OCR snippet (label/menu vs dish) via /api/scan/intent.
# Requires AI_SCAN_ENABLED + YC_SCAN_INTENT_LLM on the API. Heuristic fallback when off.
EXPO_PUBLIC_YC_SCAN_INTENT_LLM=false

# Option C: Yandex Search ingredients via /api/search/ingredients when OFF/catalog miss.
# Requires YC_SEARCH_ENABLED on the API.
EXPO_PUBLIC_YC_SEARCH=false

# Phase 3: SpeechKit STT via /api/stt (OS speech recognition remains default).
EXPO_PUBLIC_YC_STT=false

# Look up barcodes in the backend product catalog (/api/products/:barcode)
# before Open Food Facts. Requires the catalog DB to be seeded/imported.
EXPO_PUBLIC_PRODUCT_DB=false

# Optional product analytics (logs + optional HTTP endpoint)
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_ANALYTICS_ENDPOINT=

# Encrypted cloud backup/sync (requires backend auth + running API)
EXPO_PUBLIC_CLOUD_SYNC=false

# Google basemap + Google Pollen UPI heatmap on the pollen layer.
# Disabled by default; Maps key must be restricted per platform/referrer.
EXPO_PUBLIC_POLLEN_HEATMAP=off
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Prefer Google Maps as the unified map basemap (pins + heatmap) when key is set.
# EAS preview/staging/production set this true; provide EXPO_PUBLIC_GOOGLE_MAPS_API_KEY via EAS secrets.
EXPO_PUBLIC_GOOGLE_MAP_PRIMARY=false
# Phase 2: Map tab numeric/forecast from Google Pollen (wellness stays on Open-Meteo).
EXPO_PUBLIC_MAP_POLLEN_GOOGLE_PRIMARY=false
# Phase 3a: near-real-time geo-linked pollen plume on the interactive map.
EXPO_PUBLIC_MAP_POLLEN_PLUME=false
# Fetch live restaurants/medical POIs via API Places proxy (offline catalog remains fallback).
EXPO_PUBLIC_MAP_PLACES=false
# Alias kept for older clients — same as EXPO_PUBLIC_MAP_PLACES.
EXPO_PUBLIC_LIVE_MAP=false

# --- API server ---
API_PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/allerguide
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Database (Neon-ready) ---
# Runtime uses DATABASE_URL (on Neon: the POOLED `-pooler` endpoint).
# Migrations use DIRECT_DATABASE_URL (on Neon: the DIRECT/unpooled endpoint);
# falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=
# Optional read replica for read-only catalog queries (falls back to primary).
READ_DATABASE_URL=
# TLS: 'require' for managed Postgres (Neon), 'disable' for plain local PG,
# empty to honor sslmode in the connection string.
DB_SSL=
# Disable prepared statements for PgBouncer transaction pooling (Neon pooled): set 'false'.
DB_PREPARE=
# Connection pool tuning (optional).
DB_POOL_MAX=
DB_IDLE_TIMEOUT=
DB_CONNECT_TIMEOUT=
DB_MAX_LIFETIME=
SESSION_SECRET=change-me-to-a-long-random-string

# Strict CORS allowlist (comma-separated). Leave empty to reflect any origin (dev only).
CORS_ORIGINS=
# Rate limiting (per IP). Set RATE_LIMIT_DISABLED=true to turn off (e.g. in tests).
RATE_LIMIT_DISABLED=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_MAX=30
POLLEN_RATE_LIMIT_WINDOW_MS=60000
POLLEN_RATE_LIMIT_MAX=120
PLACES_RATE_LIMIT_WINDOW_MS=60000
PLACES_RATE_LIMIT_MAX=60

# Server-only Google Pollen tile + forecast proxy. Never expose this key in Expo env.
# Forecast uses the same GOOGLE_POLLEN_API_KEY when POLLEN_HEATMAP_ENABLED=true.
POLLEN_HEATMAP_ENABLED=false
GOOGLE_POLLEN_API_KEY=

# Live Google Places Nearby proxy for map POIs (restaurants / hospital / pharmacy).
MAP_PLACES_ENABLED=false
# Optional dedicated Places key; falls back to GOOGLE_POLLEN_API_KEY / GOOGLE_MAPS_SERVER_API_KEY.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Replit OIDC (optional; only if using Replit auth integration)
REPL_ID=
ISSUER_URL=

# Cloud sync endpoints. Persisted to PostgreSQL; auth via mobile JWT or the
# shared SYNC_API_KEY below. Payloads are stored opaquely (client-side encrypted).
SYNC_ENABLED=false
# Optional shared secret (legacy/server-to-server) when SYNC_ENABLED=true
SYNC_API_KEY=

# Product catalog: on a barcode miss, fetch from Open Food Facts and cache it
# (write-through) in the products table. Set to 'false' to disable.
PRODUCT_OFF_FALLBACK=true
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
# Open Food Facts requires a descriptive User-Agent (app name + contact).
OPENFOODFACTS_USER_AGENT=A-Claro/1.0 (support@aclearo.com)

# Yandex Market affiliate (P5.5 / YM-A…C). Secrets stay on API — never in EXPO_PUBLIC_*.
# Register in Яндекс Дистрибуция, obtain clid + OAuth, create creatives (erid).
# Docs: docs/yandex-market-affiliate.md
YANDEX_MARKET_CLID=
YANDEX_MARKET_OAUTH_TOKEN=
YANDEX_MARKET_ERID=
# YANDEX_MARKET_API_BASE=https://api.content.market.yandex.ru/v3/affiliate
# Curator-only draft search (YM-D). Never enable for end-user “safe” catalog.
YANDEX_MARKET_CURATOR_SEARCH=false

# LLM scan. Disabled by default.
# AI_PROVIDER=yandex|openai (default openai). Staging on YC uses yandex + Lockbox YC_AI_*.
AI_SCAN_ENABLED=false
AI_PROVIDER=openai
YC_FOLDER_ID=
YC_AI_API_KEY=
YC_GPT_MODEL=yandexgpt-lite
# Vision OCR (Phase 2) — YC_OCR_ENABLED=true + same YC_AI_* key
YC_OCR_ENABLED=false
# Option B — GPT intent classifier (/api/scan/intent); needs AI_SCAN_ENABLED
YC_SCAN_INTENT_LLM=false
# Option C — Yandex Search API ingredients (/api/search/ingredients)
YC_SEARCH_ENABLED=false
# Phase 3 — SpeechKit STT (/api/stt); same YC_AI_* key
YC_STT_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Require a valid JWT to call /api/scan (default off; falls back to per-IP budget).
SCAN_REQUIRE_AUTH=false
# OCR auth inherits SCAN_REQUIRE_AUTH unless OCR_REQUIRE_AUTH is set.
# OCR_REQUIRE_AUTH=false
# Result cache (cuts repeat LLM cost) and per-identity daily budget.
SCAN_CACHE_TTL_MS=86400000
SCAN_CACHE_MAX=1000
SCAN_DAILY_BUDGET=100
# Search ingredients cache/budget (fallback to SCAN_* when unset)
# SEARCH_CACHE_TTL_MS=86400000
# SEARCH_CACHE_MAX=1000
# SEARCH_DAILY_BUDGET=100
# STT_REQUIRE_AUTH=false
# STT_MAX_BASE64_CHARS=3000000

# Password reset email (Resend). Dev: PASSWORD_RESET_TOKEN_IN_RESPONSE=true
RESEND_API_KEY=
EMAIL_FROM=Aclearo <noreply@aclearo.com>
PASSWORD_RESET_APP_URL=https://aclearo.com/reset-password
PASSWORD_RESET_TOKEN_IN_RESPONSE=false

# Alias feedback admin review (PATCH /api/alias-feedback/:id)
ALIAS_FEEDBACK_ADMIN_KEY=
