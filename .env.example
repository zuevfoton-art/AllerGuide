# AllerGuide — environment variables
# Copy to `.env` and fill in values for local development.

# --- Mobile (Expo) ---
# Public API URL for optional cloud sync (disabled in v1.0 mobile UI)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Use PostgreSQL backend for auth and profiles (JWT)
EXPO_PUBLIC_BACKEND_AUTH=false

# Optional crash reporting (Sentry). Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=

# Smart LLM scan via API (/api/scan). Requires AI_SCAN_ENABLED on server.
EXPO_PUBLIC_AI_SCAN_ENABLED=false

# Optional product analytics (logs + optional HTTP endpoint)
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_ANALYTICS_ENDPOINT=

# --- API server ---
API_PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/allerguide
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_SECRET=change-me-to-a-long-random-string

# Replit OIDC (optional; only if using Replit auth integration)
REPL_ID=
ISSUER_URL=

# Cloud sync endpoints (disabled by default until v1.1)
SYNC_ENABLED=false
# Optional shared secret when SYNC_ENABLED=true
SYNC_API_KEY=

# LLM scan (OpenAI-compatible). Disabled by default.
AI_SCAN_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
