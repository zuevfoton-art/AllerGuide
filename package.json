{
  "name": "allerguide",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "android-release": "pnpm --filter mobile android-release",
    "lint": "pnpm --filter mobile lint && pnpm --filter api lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @allerguide/core test && pnpm --filter @allerguide/ai test && pnpm --filter mobile test && pnpm --filter api test",
    "rc-gate": "node scripts/rc-gate-check.mjs",
    "rc-gate:quick": "node scripts/rc-gate-check.mjs --quick",
    "check:analytics-taxonomy": "node scripts/check-analytics-taxonomy.mjs",
    "yc-stage-phase0": "bash scripts/yc-stage-phase0-gate.sh",
    "yc-stage-phase1": "bash scripts/yc-stage-phase1-enable-pollen.sh",
    "yc-stage-enable-yandex-maps": "bash scripts/yc-stage-enable-yandex-maps.sh",
    "yc-stage-enable-places-air-quality": "bash scripts/yc-stage-enable-places-air-quality.sh",
    "yc-stage-enable-scan-intent-search": "bash scripts/yc-stage-enable-scan-intent-search.sh",
    "yc-stage-enable-dish-vision": "bash scripts/yc-stage-enable-dish-vision.sh",
    "yc-stage-phase2": "bash scripts/yc-stage-phase2-gate.sh",
    "yc-stage-phase3": "bash scripts/yc-stage-phase3-gate.sh",
    "yc-stage-phase4": "bash scripts/yc-stage-phase4-gate.sh",
    "yc-stage-phase5": "bash scripts/yc-stage-phase5-gate.sh",
    "map-pollen-ops-check": "bash scripts/check-map-pollen-fallback.sh"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@xmldom/xmldom": "0.9.12",
      "ws": "8.21.0",
      "undici": "7.28.0",
      "fast-uri": "4.1.3",
      "uuid": "11.1.1",
      "shell-quote": "1.10.0",
      "esbuild": "0.25.0",
      "js-yaml": "4.3.2",
      "brace-expansion": "5.0.9",
      "minimatch": "10.2.6",
      "glob": "11.1.0",
      "glob@10.5.0": "11.1.0",
      "expo-modules-autolinking>glob": "11.1.0",
      "glob@10.5.0>minimatch": "10.2.6",
      "postcss": "8.5.28",
      "nanoid": "3.3.18",
      "qs": "6.16.0",
      "decode-uri-component": "0.5.0",
      "tar": "7.5.22",
      "node-forge": "1.4.0",
      "eas-cli>ajv": "8.20.0",
      "joi": "17.13.7",
      "ts-deepmerge": "8.0.0",
      "yaml": "2.9.0",
      "diff": "8.0.4",
      "@babel/core": "7.29.7",
      "drizzle-orm": "0.45.2",
      "@expo/dom-webview": "55.0.6"
    },
    "patchedDependencies": {
      "expo-modules-core@55.0.25": "patches/expo-modules-core@55.0.25.patch"
    }
  },
  "devDependencies": {
    "pnpm": "10.34.5"
  }
}
