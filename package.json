      "ws": "8.21.0",
      "undici": "7.28.0",
      "fast-uri": "4.0.0",
      "uuid": "11.1.1",
      "shell-quote": "1.8.4",
      "esbuild": "0.25.0",
      "js-yaml": "4.2.0",
      "brace-expansion": "5.0.6",
      "postcss": "8.5.10",
      "tar": "7.5.16",
      "@babel/core": "7.29.7",
      "drizzle-orm": "0.45.2"
    }
  }
