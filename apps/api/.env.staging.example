# Aclearo API — staging environment (no secrets)
# Copy to hosting provider env / GitHub Actions secrets.
# Canonical reference: docs/staging-deploy.md

# --- Public URL (after P1.1c DNS) ---
# STAGING_API_URL=https://api.staging.aclearo.com

API_PORT=3001

# --- Neon staging (P1.1a) ---
# Runtime: pooled endpoint (host contains -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Migrations: direct (unpooled) endpoint
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSL=require
DB_PREPARE=false

# --- Auth ---
JWT_SECRET=generate-with-openssl-rand-hex-32
SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- CORS (comma-separated; native apps do not send Origin — browser/web staging only) ---
CORS_ORIGINS=https://staging.aclearo.com,https://aclearo.com

# --- Cloud sync (zero-knowledge ciphertext) ---
SYNC_ENABLED=true
# SYNC_API_KEY=optional-legacy-server-key

# --- AI scan (Phase 1: YandexGPT on YC staging) ---
AI_SCAN_ENABLED=true
AI_PROVIDER=yandex
# From Lockbox on YC (do not commit secrets)
YC_FOLDER_ID=
YC_AI_API_KEY=
YC_GPT_MODEL=yandexgpt-lite
# Optional OpenAI-compatible fallback for non-YC environments
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SCAN_REQUIRE_AUTH=true
SCAN_DAILY_BUDGET=50
SCAN_CACHE_TTL_MS=86400000
SCAN_CACHE_MAX=1000

# --- Product catalog (optional on staging) ---
PRODUCT_OFF_FALLBACK=true
OPENFOODFACTS_USER_AGENT=A-Claro/1.0-staging (support@aclearo.com)

# --- Rate limits (keep enabled on staging) ---
RATE_LIMIT_DISABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_MAX=30

# --- Replit OIDC: leave unset on standalone staging API ---
# REPL_ID=
# ISSUER_URL=

# --- Do not set on API-only staging deploy ---
# METRO_URL=
