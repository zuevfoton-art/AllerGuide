# Aclearo API — staging environment (no secrets)
# Copy to hosting provider env / GitHub Actions secrets.
# Canonical reference: docs/staging-deploy.md

# --- Public URL (after P1.1c DNS) ---
# STAGING_API_URL=https://api.staging.aclearo.com

API_PORT=3001

# --- Yandex Cloud Managed PostgreSQL (P1.1a) ---
# Staging cluster is private-VPC; port 6432 is Odyssey pooler (see infra/yandex/staging/postgresql.tf).
DATABASE_URL=postgresql://USER:PASSWORD@c-xxxxx.rw.mdb.yandexcloud.net:6432/allerguide?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@c-xxxxx.rw.mdb.yandexcloud.net:6432/allerguide?sslmode=require
DB_SSL=require
DB_PREPARE=false

# --- Auth ---
JWT_SECRET=generate-with-openssl-rand-hex-32
SESSION_SECRET=generate-with-openssl-rand-hex-32
# ACCESS_TOKEN_TTL=30m
# ACCESS_TOKEN_TTL_SECONDS=1800
# REFRESH_TOKEN_TTL_MS=2592000000

# --- CORS (comma-separated; native apps do not send Origin — browser/web staging only) ---
# Include local Expo web when developing against staging API.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://staging.aclearo.com,https://staging.aclearo.ru,https://aclearo.com,https://aclearo.ru

# --- Cloud sync (zero-knowledge ciphertext) ---
SYNC_ENABLED=true
# JWT only on staging — do not set SYNC_API_KEY (ignored while JWT_SECRET is set).
SYNC_REQUIRE_ENCRYPTED=true

# --- AI scan (Phase 0–2: YandexGPT + Vision OCR on YC staging) ---
AI_SCAN_ENABLED=true
AI_PROVIDER=yandex
# From Lockbox on YC (do not commit secrets)
YC_FOLDER_ID=
YC_AI_API_KEY=
YC_GPT_MODEL=yandexgpt-lite
# Option D — multimodal dish photo (plate-only). On for staging QA (Lockbox + VL model).
AI_DISH_VISION_ENABLED=true
# Medicine package vision. Public catalog writes need MEDICINE_WRITE_KEY;
# device JWT writes go to profile.medicine_overlays only.
AI_MEDICINE_VISION_ENABLED=true
# Shared key for server-to-server catalog writes (POST /api/medicines), e.g. db:seed-medicines.
# Device writes use the mobile JWT instead. Keep in Lockbox, never in a client bundle.
MEDICINE_WRITE_KEY=
# YC_VISION_MODEL=qwen3.6-35b-a3b/latest
# YC_VISION_BASE_URL=https://ai.api.cloud.yandex.net/v1/chat/completions
# Vision OCR (Phase 2). Same YC_AI_* credentials.
YC_OCR_ENABLED=true
# Option B — GPT intent on OCR text (/api/scan/intent). Enable via Lockbox on stage.
YC_SCAN_INTENT_LLM=true
# Option C — Yandex Search ingredients when OFF/catalog miss. Enable via Lockbox on stage.
YC_SEARCH_ENABLED=true
# Optional LLM dish/product resolve (POST /api/dishes/resolve). On for staging QA.
DISH_LLM_ENABLED=true
# Phase 3 — SpeechKit STT (enabled on staging for QA)
YC_STT_ENABLED=true
# Optional OpenAI-compatible fallback for non-YC environments
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SCAN_REQUIRE_AUTH=true
# OCR auth defaults to SCAN_REQUIRE_AUTH when OCR_REQUIRE_AUTH unset
# OCR_REQUIRE_AUTH=true
SCAN_DAILY_BUDGET=100
SCAN_CACHE_TTL_MS=86400000
SCAN_CACHE_MAX=1000
# SEARCH_DAILY_BUDGET=100

# --- Product catalog (optional on staging) ---
PRODUCT_OFF_FALLBACK=true
OPENFOODFACTS_USER_AGENT=A-Claro/1.0-staging (support@aclearo.com)

# --- Google Pollen heatmap proxy (stage: enable via Lockbox, see Phase 1) ---
# Target on YC staging: POLLEN_HEATMAP_ENABLED=true + GOOGLE_POLLEN_API_KEY in Lockbox.
POLLEN_HEATMAP_ENABLED=true
# From the staging secret manager; server/IP restricted, never EXPO_PUBLIC_*.
GOOGLE_POLLEN_API_KEY=
POLLEN_RATE_LIMIT_WINDOW_MS=60000
POLLEN_RATE_LIMIT_MAX=120
# Experimental only. Official product uses TREE/GRASS/WEED tiles (no-go for species heatmap).
POLLEN_SPECIES_HEATMAP_ENABLED=false

# --- Google Places (New) + Air Quality (Lockbox + pnpm yc-stage-enable-places-air-quality) ---
# Dedicated Places/AQ keys required. Runtime does not fall back to GOOGLE_POLLEN_API_KEY.
# Never EXPO_PUBLIC_*.
# MAP_PLACES_ENABLED=true
# GOOGLE_PLACES_API_KEY=
# PLACES_RATE_LIMIT_WINDOW_MS=60000
# PLACES_RATE_LIMIT_MAX=60
# AIR_QUALITY_ENABLED=true
# GOOGLE_AIR_QUALITY_API_KEY=

# --- Yandex interactive basemap embed (Lockbox + pnpm yc-stage-enable-yandex-maps) ---
# YANDEX_MAPS_INTERACTIVE_ENABLED=true
# YANDEX_MAPS_JS_API_KEY=
# MAPS_RATE_LIMIT_WINDOW_MS=60000
# MAPS_RATE_LIMIT_MAX=60

# --- Yandex Market affiliate (secrets via Lockbox / Actions — never EXPO_PUBLIC) ---
# YANDEX_MARKET_CLID=
# YANDEX_MARKET_OAUTH_TOKEN=
# YANDEX_MARKET_ERID=
# YANDEX_MARKET_CURATOR_SEARCH=false
# YANDEX_MARKET_FEED_URL=
# MARKET_PHARMACY_FEED_ENABLED=false
# MARKET_PHARMACY_FEED_URL=

# --- Rate limits (keep enabled on staging) ---
RATE_LIMIT_DISABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_MAX=30

# --- Do not set on API-only staging deploy ---
# METRO_URL=
