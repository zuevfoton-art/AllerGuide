# AllerGuide mobile — подключение к backend на Replit.
#
# Скопируйте этот файл в apps/mobile/.env, чтобы локальная сборка (Metro / gradle)
# ходила в https://aller-guide.replit.app вместо localhost:
#
#   cp apps/mobile/.env.replit.example apps/mobile/.env
#
# EXPO_PUBLIC_* переменные встраиваются в JS-бандл ВО ВРЕМЯ сборки, поэтому после
# правки нужно пересобрать APK (release) или перезапустить Metro (debug).

# Абсолютный URL backend (для native origin обязателен — без него fetch не работает).
EXPO_PUBLIC_API_URL=https://aller-guide.replit.app

# Включает серверную JWT-аутентификацию и серверные профили (register/login → Replit).
EXPO_PUBLIC_BACKEND_AUTH=true

# Остальные интеграции оставляем выключенными для internal-сборки.
EXPO_PUBLIC_CLOUD_SYNC=false
EXPO_PUBLIC_AI_SCAN_ENABLED=false
EXPO_PUBLIC_PRODUCT_DB=false
EXPO_PUBLIC_ANALYTICS_ENABLED=false
