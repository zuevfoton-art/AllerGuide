EXPO_PUBLIC_BACKEND_AUTH=true
EXPO_PUBLIC_CLOUD_SYNC=false
EXPO_PUBLIC_AI_SCAN_ENABLED=false
EXPO_PUBLIC_PRODUCT_DB=false
EXPO_PUBLIC_ANALYTICS_ENABLED=false
