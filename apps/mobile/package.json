{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate-assets": "node scripts/generate-assets.mjs",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios"
  },
  "dependencies": {
    "@allerguide/ai": "workspace:*",
    "@allerguide/core": "workspace:*",
    "@allerguide/ui": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo/metro-runtime": "^5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.0.0",
    "expo-crypto": "~14.0.0",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.0.0",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.0",
    "expo-print": "~14.0.0",
    "expo-router": "~5.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eas-cli": "^16.32.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "sharp": "^0.35.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
