# AllerGuide mobile — локальная/stage сборка против Yandex Cloud staging API.
#
# Каноничный stage backend: https://api.staging.aclearo.com
#
#   cp apps/mobile/.env.staging.example apps/mobile/.env
#
# EXPO_PUBLIC_* встраиваются в бандл при сборке — после правки пересоберите
# APK / перезапустите Metro.
#
# Облачные stage-сборки: eas.json profile `staging` или
#   pnpm --filter mobile build:staging:android
# Maps key: EAS Sensitive `EXPO_PUBLIC_GOOGLE_MAPS_API_KEY` (не коммитить).

EXPO_PUBLIC_API_URL=https://api.staging.aclearo.com
EXPO_PUBLIC_BACKEND_AUTH=true
EXPO_PUBLIC_CLOUD_SYNC=true
EXPO_PUBLIC_AI_SCAN_ENABLED=true
# Option D — plate-only dish vision (needs API AI_DISH_VISION_ENABLED)
EXPO_PUBLIC_AI_DISH_VISION=true
EXPO_PUBLIC_YC_OCR=true
# Option B/C — enable with matching API flags
EXPO_PUBLIC_YC_SCAN_INTENT_LLM=true
EXPO_PUBLIC_YC_SEARCH=true
EXPO_PUBLIC_PRODUCT_DB=false
EXPO_PUBLIC_MEDICINE_DB=true
EXPO_PUBLIC_POLLEN_HEATMAP=google
EXPO_PUBLIC_GOOGLE_MAP_PRIMARY=true
EXPO_PUBLIC_MAP_POLLEN_GOOGLE_PRIMARY=true
EXPO_PUBLIC_MAP_POLLEN_PLUME=true
EXPO_PUBLIC_YANDEX_MAP_INTERACTIVE=true
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_APP_ENV=staging

# Задайте локально / в EAS (Sensitive), не в git:
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side Yandex JS key lives in Lockbox (YANDEX_MAPS_JS_API_KEY) — never EXPO_PUBLIC_*.
