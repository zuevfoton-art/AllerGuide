modules = ["nodejs-20", "ruby-3.2", "swift-5.8", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["javascript_log_in_with_replit:2.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Metro"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && METRO_URL=http://localhost:3001 npx tsx src/index.ts"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Metro"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/mobile && EXPO_NO_OPEN_BROWSER=1 npx expo start --web --port 3001"
waitForPort = 3001

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
ignoreDatabaseMigrations = false
build = ["bash", "scripts/replit-deploy-build.sh"]
run = ["bash", "-c", "source scripts/replit-db-env.sh && cd apps/api && npx tsx src/index.ts"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_BACKEND_AUTH = "true"
JWT_SECRET = "49070571c862141791c05039b4c0ef1b3c966040428a757cb4807258b7469cb37ebfa1480e52fb2151605d0c18ced768"
