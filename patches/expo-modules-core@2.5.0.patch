+    // Patched (AllerGuide): guard against a null backed object instead of
+    // dereferencing it. When a module's LazyObject fails to initialize (e.g. the
+    // native runtime is being torn down, or an AV/audio module cannot install its
+    // JSI bindings), backedObject stays null and `*backedObject` hard-crashes with
+    // a native SIGSEGV in the JS thread (fault addr 0x10), bypassing JS try/catch.
+    // `LazyObject::get`/`set` already null-check; mirror that here.
+    if (!lazyObject->backedObject) {
+      return object;
+    }
     return *lazyObject->backedObject;
